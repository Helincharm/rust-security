{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project",
    "created_at",
    "files",
    "findings",
    "diagnostics",
    "manifests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manifests": {
      "type": "array"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "scan_id",
          "observed_at_unix",
          "id",
          "tool",
          "category",
          "severity_source",
          "severity",
          "evidence",
          "path",
          "line",
          "column",
          "end_line",
          "end_column",
          "confidence",
          "verification_status",
          "explanation",
          "remediation",
          "cwe"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_status": {
            "enum": [
              "version_matched",
              "analysis_incomplete",
              "unverified_static_observation"
            ]
          }
        }
      }
    }
  }
}
